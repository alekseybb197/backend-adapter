<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "https://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.backend-adapter</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>~/backend-adapter/backend-adapter.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>~/backend-adapter</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>ADAPTER_BACKEND_CONFIG</key>
        <string>~/backend-adapter/sample.adapter.yaml</string>
        <key>ADAPTER_PROXY_PORT</key>
        <string>9999</string>
        <key>ADAPTER_DEBUG_ENABLE</key>
        <string>1</string>
        <key>ADAPTER_DETACH_ENABLE</key>
        <string>0</string>
        <key>ADAPTER_STREAMING_ENABLE</key>
        <string>1</string>
        <key>ADAPTER_STREAM_INCLUDE_USAGE</key>
        <string>1</string>
        <key>ADAPTER_STRICT_MODELS</key>
        <string>1</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <false/>

    <key>StandardOutPath</key>
    <string>~/backend-adapter/adapter.log</string>

    <key>StandardErrorPath</key>
    <string>~/backend-adapter/adapter.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
