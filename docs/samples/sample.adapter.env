# ============================================================
# sample.adapter.env — пример полного окружения backend-adapter
# ============================================================
# Рабочий env-файл адаптера: скопируйте в adapter.env и заполните.
# Используется для запуска из исходников (./scripts/dev-run.sh) и как
# справочник значений для systemd/launchd (см. install.md, раздел 9).
# Токен бэкенда: значение переменной, на которую ссылается поле key
# в YAML-конфиге (см. ниже ADAPTER_BACKEND_CONFIG).

# --- Backend connection ---
# Путь к YAML-файлу конфигурации бэкендов — единственный способ указать
# подключение. Пример файла — docs/samples/sample.adapter.yaml
# (структура backend: - name/base/key; key — имя переменной окружения,
# в которой лежит токен).
export ADAPTER_BACKEND_CONFIG='adapter.yaml'
# Токен бэкенда (имя переменной задано полем key YAML-конфига):
export ADAPTER_BACKEND_KEY_LLM_SERVICE='*****'

# --- Server settings ---
# Порт, на котором слушает адаптер (его адрес указывается клиенту как
# ANTHROPIC_BASE_URL).
export ADAPTER_PROXY_PORT=9999
# Адрес, на котором слушает адаптер (default: localhost; 0.0.0.0 — все
# интерфейсы).
export ADAPTER_ENDPOINT_HOST="127.0.0.1"

# --- Network ---
# Таймаут запроса к бэкенду, сек (в т.ч. между чанками стрима).
export ADAPTER_TIMEOUT=300
# Количество повторов при таймауте/429/502/503/504 (задержка 2^attempt).
export ADAPTER_RETRY_COUNT=3

# --- Streaming ---
# SSE streaming passthrough (0 — ждать ответ целиком).
export ADAPTER_STREAMING_ENABLE=1
# Передавать usage-блок в стриме (требует stream_options.include_usage).
export ADAPTER_STREAM_INCLUDE_USAGE=1

# --- Models ---
# Строгая валидация: модель запроса должна быть в /v1/models бэкенда
# (0 — принимать любую модель).
export ADAPTER_STRICT_MODELS=1
# Маппинг имён моделей agent:backend (пустое имя слева — все модели).
export ADAPTER_MODELS_MAPPING=":qwen36"

# --- Input endpoint routing (TARGET, v0.9.0) ---
# Три входных POST-эндпоинта: /v1/messages, /v1/chat/completions, /v1/responses.
# Префикс переменной = входной эндпоинт; значение — целевой формат (прямое
# преобразование входа в него), passthrough (дословная передача без
# преобразования) или none (вход выключен → 404). Значение auto прежних
# версий удалено в v0.9.4 (невалидно → [WARN] + none).
# Дефолты = нулевая настройка (прежнее поведение 100%): принимается только
# /v1/messages и конвертируется в chat.completions; два других входа закрыты.
export ADAPTER_MESSAGES_TARGET=completions
# export ADAPTER_COMPLETIONS_TARGET=passthrough   # дословно на /v1/chat/completions
# export ADAPTER_RESPONSES_TARGET=passthrough     # дословно на /v1/responses
# export ADAPTER_MESSAGES_TARGET=messages         # преобразование messages→messages
#                                                 # (сортировка system в начало)

# --- Model usage (таблица «Models in use» WEBUI) ---
# Путь к YAML-файлу с тарифами моделей — для колонки Cost таблицы
# (стоимость накопленных токенов по тарифу; формат файла — см.
# docs/environment.md, §5). Пусто — колонка Cost показывает «--».
# export ADAPTER_MODELS_TARIFFS='adapter.tariffs.yaml'

# --- Sessions (таблица «Sessions» WEBUI + per-session логи) ---
# Список кандидатов id сессии агента (через запятую); побеждает первый
# непустой, ни одного — «unknown». Элемент «Имя-заголовка» — плоский
# заголовок, «Имя:ключ» — значение разбирается как JSON и берётся строковое
# поле «ключ». [CC] CLI шлёт X-Claude-Code-Session-Id; Codex CLI — JSON-заголовок
# x-codex-turn-metadata (дефолт берёт из него session_id); QwenCode id по
# умолчанию не шлёт и требует настройки клиента (customHeaders +
# allowDynamicHeaderValues — см. docs/environment.md, §5, «Настройка агента
# (QwenCode)»). x-client-request-id (дубль id у Codex) в дефолт не входит —
# добавьте явно, если ваш клиент шлёт id сессии в нём.
# export ADAPTER_SESSION_HEADER='X-Claude-Code-Session-Id,x-opencode-session,x-codex-turn-metadata:session_id'

# --- Logging ---
# Файловая запись debug/trace/*.parts-дампов (0 — на диск ничего не
# пишется; консольные debug-логи безусловны и от этого флага не зависят).
export ADAPTER_DEBUG_ENABLE=0
# Директория логов сессий (debug/trace/*.parts) и корень WEBUI; при
# незаданной/пустой — дефолт ./tmp/logs (создаётся при старте).
export ADAPTER_DEBUG_LOGPATH="./tmp/logs"
# Лимит обрезки КОНСОЛЬНЫХ debug-строк, симв. (0 — без обрезки). Файловый
# канал (session-*.log при ENABLE=1) пишет ПОЛНЫЕ строки — без обрезки.
export ADAPTER_DEBUG_TRIM=2000
# JSON/YAML-дампы per-session ВСЕХ логгируемых частей протокола
# (BODY/TOOL_RESULT/OPENAI_BODY/FETCH_RAW/RESPONSE — .json+.yaml парой;
# по умолчанию 0 — выкл; требуют ADAPTER_DEBUG_ENABLE=1 и
# ADAPTER_DEBUG_LOGPATH).
export ADAPTER_DEBUG_PARTS=0
# Обрезка полей reasoning в trace-событиях (0 — без обрезки).
export ADAPTER_TRACE_REASONING_MAX_CHARS=0
# Обрезка поля content в tool_result/trace (0 — без обрезки).
export ADAPTER_TRACE_TOOL_FIELD_MAX_CHARS=0

# --- Sanitizer (secret masking in logs) ---
# 0 = маскирование секретов активно (по умолчанию), 1 = отключено
# (сырые токены/ключи в логах).
export ADAPTER_SENSITIVE_LOGGING_ENABLE=0

# --- WEBUI (статус-страница /, вкладки /session, /config) ---
# Поднимается всегда (флага отключения нет); корень — ADAPTER_DEBUG_LOGPATH.
export ADAPTER_WEBUI_HOST="127.0.0.1"
export ADAPTER_WEBUI_PORT=8765
# Prometheus-экспортёр — отдельный слушатель метрик:
# export ADAPTER_EXPORTER_ENABLE=1
# export ADAPTER_EXPORTER_PORT=9100

# --- Mode ---
# Detach-режим (double fork; НЕ включать вместе с systemd/launchd).
export ADAPTER_DETACH_ENABLE=0
# Имя PID-файла для detach-режима (кладётся в ADAPTER_DEBUG_LOGPATH).
export ADAPTER_PIDFILE='adapter.pid'
