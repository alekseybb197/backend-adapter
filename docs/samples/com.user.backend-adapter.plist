<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "https://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Минимальный вариант: подход через root. -->
    <!-- Все настройки подхватываются из <root>/adapter.env автоматически. -->
    <!-- ВАЖНО: launchd НЕ раскрывает ~ и переменные окружения — замените -->
    <!-- /Users/USERNAME на свой домашний путь перед загрузкой агента. -->
    <!-- EnvironmentVariables побеждают adapter.env (они попадают в окружение -->
    <!-- процесса раньше, а файл ставит значения через setdefault): здесь два -->
    <!-- инварианта сервиса — путь к adapter.yaml и выключенный detach. -->

    <key>Label</key>
    <string>com.user.backend-adapter</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/USERNAME/.local/bin/backend-adapter</string>
        <string>--root</string>
        <string>/Users/USERNAME/.ba</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/USERNAME/.ba</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>ADAPTER_BACKEND_CONFIG</key>
        <string>/Users/USERNAME/.ba/adapter.yaml</string>
        <key>ADAPTER_DETACH_ENABLE</key>
        <string>0</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>KeepAlive</key>
    <false/>

    <!-- Лог сервиса — вне дома: <root>/log принадлежит работающему адаптеру. -->
    <key>StandardOutPath</key>
    <string>/Users/USERNAME/Library/Logs/backend-adapter/adapter.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/USERNAME/Library/Logs/backend-adapter/adapter.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
