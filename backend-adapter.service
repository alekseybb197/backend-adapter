[Unit]
Description=Claude Code <-> OpenAI Backend Adapter
After=network.target

[Service]
Type=simple
User=username
WorkingDirectory=%h/backend-adapter
EnvironmentFile=%h/backend-adapter/backend-adapter.env
ExecStart=/usr/bin/python3 %h/backend-adapter/backend-adapter.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=backend-adapter

[Install]
WantedBy=default.target
