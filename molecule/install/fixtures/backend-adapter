#!/bin/sh
# Fixture stand-in for the release binary `backend-adapter`.
#
# It reproduces the two startup behaviours install.sh relies on (see
# backend-adapter.py:99-104 and the identical self-check in
# scripts/build-binaries.sh):
#
#   * empty ADAPTER_BACKEND_CONFIG -> banner + "[FATAL] ... is not set" + exit 1
#     (the healthy early-exit that verify() greps for);
#   * non-empty ADAPTER_BACKEND_CONFIG -> keep running, so the systemd unit
#     (Type=simple, --service scenario) actually reaches `active`.
echo "Backend-Adapter v0.0.0-molecule-fixture"
echo "======================================================================"

if [ -z "${ADAPTER_BACKEND_CONFIG:-}" ]; then
  echo "[FATAL] ADAPTER_BACKEND_CONFIG is not set. Задайте путь к YAML-файлу конфигурации бэкенда (пример — docs/samples/sample.adapter.yaml)."
  exit 1
fi

echo "fixture: config present, running (sleep infinity)"
exec sleep infinity
