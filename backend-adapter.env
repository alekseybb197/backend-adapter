# ============================================================
# backend-adapter.env — environment for systemd service
# Source file for: backend-adapter.service
# ============================================================

# --- Backend connection ---
# Путь к YAML-файлу конфигурации бэкендов — единственный способ
# указать подключение. Пример файла — sample.adapter.yaml в корне
# репозитория (структура backend: - name/base/key; key — имя
# переменной окружения, в которой лежит токен).
export ADAPTER_BACKEND_CONFIG="/home/username/backend-adapter/sample.adapter.yaml"

# --- Server settings ---
# Port the adapter listens on
export ADAPTER_PROXY_PORT=9999

# Host/address the adapter listens on (default: localhost; 0.0.0.0 — all interfaces)
# export ADAPTER_ENDPOINT_HOST="127.0.0.1"

# --- Debugging ---
# Set to 0 to suppress all console logs (logs go to journal anyway)
export ADAPTER_DEBUG_ENABLE=1

# Optional: log directory (session logs, traces, *.parts dumps, WEBUI root)
# By default no logs are written to disk — set this to enable file logging.
# export ADAPTER_DEBUG_LOGPATH="/home/username/tmp/adapter-logs"

# Tool error processing is OFF by default (zero-config). Uncomment to enable.
# export ADAPTER_DEBUG_TOOLS_ERROR=1

# --- Detach mode ---
# Do NOT enable detach (detached processes are not managed by systemd)
export ADAPTER_DETACH_ENABLE=0
